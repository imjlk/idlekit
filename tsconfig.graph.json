{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@idlekit/core": ["./packages/core/src/index.ts"],
      "@idlekit/money": ["./packages/money/src/index.ts"]
    },
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "enabled": false
      }
    ]
  },
  "include": [
    "packages/money/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/scripts/**/*.ts",
    "examples/**/*.ts",
    "snippets/**/*.ts",
    "tools/*.ts"
  ]
}
