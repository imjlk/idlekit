{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idlekit/calibrate-output-v1",
  "type": "object",
  "required": ["ok", "source", "sample", "monetization", "scenarioPatch", "_meta"],
  "dependentRequired": {
    "observation": ["patchStatus", "patchWarnings"],
    "comparison": ["observation"],
    "patchStatus": ["observation", "patchWarnings"],
    "patchWarnings": ["observation", "patchStatus"]
  },
  "$comment": "Counts, rates, cutoff consistency and exact Wilson 95% interval bounds for each observed rate are checked by assertCohortObservation before CLI output; portable JSON Schema cannot compare sibling numeric values.",
  "$defs": {
    "retentionDayOrder": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        { "type": "object", "properties": { "day": { "const": 1 } } },
        { "type": "object", "properties": { "day": { "const": 7 } } },
        { "type": "object", "properties": { "day": { "const": 30 } } },
        { "type": "object", "properties": { "day": { "const": 90 } } }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "observation": {} }, "required": ["observation"] },
      "then": { "properties": {
        "scenarioPatch": {
          "type": "object", "required": ["monetization"], "additionalProperties": false,
          "properties": { "monetization": {
            "type": "object", "required": ["retention"], "additionalProperties": false,
            "properties": { "retention": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "d1": { "type": "number", "minimum": 0, "maximum": 1 },
                "d7": { "type": "number", "minimum": 0, "maximum": 1 },
                "d30": { "type": "number", "minimum": 0, "maximum": 1 },
                "d90": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            } }
          } }
        }
      } }
    },
    {
      "if": { "required": ["patchStatus"], "properties": { "patchStatus": { "enum": ["unavailable", "requires-review"] } } },
      "then": { "properties": { "scenarioPatch": {
        "type": "object", "properties": { "monetization": {
          "type": "object", "properties": { "retention": { "type": "object", "maxProperties": 0 } }
        } }
      } } }
    },
    {
      "if": { "required": ["patchStatus"], "properties": { "patchStatus": { "const": "ready" } } },
      "then": { "properties": { "scenarioPatch": {
        "type": "object", "properties": { "monetization": {
          "type": "object", "properties": { "retention": { "type": "object", "minProperties": 1 } }
        } }
      } } }
    }
  ],
  "properties": {
    "ok": { "const": true },
    "source": { "type": "string" },
    "sample": {
      "type": "object",
      "required": ["rows", "users"],
      "properties": {
        "rows": { "type": "number" },
        "users": { "type": "number" }
      }
    },
    "monetization": {
      "type": "object",
      "required": ["retention", "revenue", "acquisition", "uncertainty"],
      "properties": {
        "retention": { "type": "object" },
        "revenue": { "type": "object" },
        "acquisition": { "type": "object" },
        "uncertainty": {
          "type": "object",
          "required": ["correlation"],
          "properties": {
            "correlation": { "type": "object" }
          }
        }
      }
    },
    "scenarioPatch": { "type": "object" },
    "patchStatus": { "enum": ["ready", "unavailable", "requires-review"] },
    "patchWarnings": { "type": "array", "items": { "type": "string" } },
    "observation": {
      "type": "object",
      "required": ["observedThroughDay", "users", "retention"],
      "properties": {
        "observedThroughDay": { "type": "integer", "minimum": 0 },
        "users": { "type": "integer", "minimum": 1 },
        "retention": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "allOf": [{ "$ref": "#/$defs/retentionDayOrder" }],
          "items": {
            "type": "object",
            "required": ["day", "status", "users", "activeUsers", "rate", "interval95"],
            "properties": {
              "day": { "enum": [1, 7, 30, 90] },
              "status": { "enum": ["observed", "not-observed"] },
              "users": { "type": "integer", "minimum": 1 },
              "activeUsers": { "type": ["integer", "null"], "minimum": 0 },
              "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "interval95": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {
                    "min": { "type": "number", "minimum": 0, "maximum": 1 },
                    "max": { "type": "number", "minimum": 0, "maximum": 1 }
                  } }
                ]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "observed" } } },
                "then": { "properties": {
                  "activeUsers": { "type": "integer" },
                  "rate": { "type": "number" },
                  "interval95": { "type": "object" }
                } }
              },
              {
                "if": { "properties": { "status": { "const": "not-observed" } } },
                "then": { "properties": {
                  "activeUsers": { "type": "null" },
                  "rate": { "type": "null" },
                  "interval95": { "type": "null" }
                } }
              }
            ]
          }
        }
      }
    },
    "comparison": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "allOf": [{ "$ref": "#/$defs/retentionDayOrder" }],
      "items": {
        "type": "object",
        "required": ["day", "assumption", "observed", "differencePercentagePoints", "status"],
        "properties": {
          "day": { "enum": [1, 7, 30, 90] },
          "assumption": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "observed": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "differencePercentagePoints": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
          "status": { "enum": ["compared", "not-observed", "unconfigured"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "compared" } } },
            "then": { "properties": {
              "assumption": { "type": "number" },
              "observed": { "type": "number" },
              "differencePercentagePoints": { "type": "number" }
            } }
          },
          {
            "if": { "properties": { "status": { "const": "not-observed" } } },
            "then": { "properties": {
              "observed": { "type": "null" },
              "differencePercentagePoints": { "type": "null" }
            } }
          },
          {
            "if": { "properties": { "status": { "const": "unconfigured" } } },
            "then": { "properties": {
              "assumption": { "type": "null" },
              "observed": { "type": "number" },
              "differencePercentagePoints": { "type": "null" }
            } }
          }
        ]
      }
    },
    "_meta": {
      "type": "object",
      "required": ["command", "contractVersion", "schemaRef", "cliVersion", "gitSha", "telemetryHash", "pluginDigest"],
      "properties": {
        "command": { "const": "calibrate" },
        "contractVersion": { "type": "string" },
        "schemaRef": { "const": "docs/schemas/calibrate.output.schema.json" },
        "cliVersion": { "type": "string" },
        "gitSha": { "type": "string" },
        "telemetryHash": { "type": "string" },
        "pluginDigest": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
