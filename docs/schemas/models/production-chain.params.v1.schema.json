{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlekit.dev/schemas/models/production-chain.params.v1.schema.json",
  "title": "Params of the built-in production-chain@1 model.",
  "type": "object",
  "properties": {
    "primary": {
      "default": {
        "idleIncome": "1"
      },
      "type": "object",
      "properties": {
        "idleIncome": {
          "default": "1",
          "type": "string",
          "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
        }
      }
    },
    "resources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "initial": {
            "default": "0",
            "type": "string",
            "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
          },
          "cap": {
            "type": "string",
            "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
          },
          "valueInPrimary": {
            "default": 0,
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "recipes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "inputs": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
            }
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
            }
          },
          "timeSec": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "build": {
            "default": {
              "currency": "primary",
              "base": "10",
              "growth": 1.15
            },
            "type": "object",
            "properties": {
              "currency": {
                "default": "primary",
                "type": "string"
              },
              "base": {
                "default": "10",
                "type": "string",
                "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              },
              "growth": {
                "default": 1.15,
                "type": "number",
                "minimum": 1
              }
            }
          },
          "maxLevel": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unlock": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recipe": {
                  "type": "string"
                },
                "level": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "recipe",
                "level"
              ]
            }
          }
        },
        "required": [
          "id",
          "outputs"
        ]
      }
    }
  },
  "required": [
    "recipes"
  ]
}
