{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlekit.dev/schemas/models/exponential.params.v1.schema.json",
  "title": "Params of the built-in exponential@1 model.",
  "type": "object",
  "properties": {
    "idleIncome": {
      "default": "1",
      "type": "string",
      "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
    },
    "baseIncome": {
      "default": "1",
      "type": "string",
      "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
    },
    "growthRate": {
      "default": 1.07,
      "type": "number",
      "minimum": 1
    },
    "costBase": {
      "default": "10",
      "type": "string",
      "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
    },
    "costGrowth": {
      "default": 1.15,
      "type": "number",
      "minimum": 1
    },
    "maxLevel": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "softCap": {
      "type": "object",
      "properties": {
        "kind": {
          "default": "pow",
          "type": "string",
          "enum": [
            "pow",
            "sqrt",
            "log"
          ]
        },
        "startsAt": {
          "type": "string",
          "pattern": "^[+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
        },
        "strength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "startsAt"
      ]
    }
  }
}
