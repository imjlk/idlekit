{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "./lint.config.ts"
      }
    ]
  },
  "include": ["src"]
}
