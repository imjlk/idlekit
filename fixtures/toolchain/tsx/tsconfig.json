{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "src",
    "paths": {
      "@opentui/react": ["../../../packages/cli/node_modules/@opentui/react"],
      "@opentui/react/*": ["../../../packages/cli/node_modules/@opentui/react/*"]
    }
  },
  "include": ["src"]
}
