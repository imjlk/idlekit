{
  "name": "@idlekit/cli",
  "version": "0.1.1",
  "description": "Bun-first idk CLI for idle game scenario validation, simulation, tuning, and reporting.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "idk": "dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/idlekit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/imjlk/idlekit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/imjlk/idlekit/issues"
  },
  "keywords": [
    "bun",
    "idle-game",
    "incremental-game",
    "cli",
    "economy-simulator",
    "game-balancing",
    "simulation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "dev:watch": "bun --watch src/main.ts",
    "generate:check": "bun scripts/command-check.ts",
    "doctor:completions": "bun scripts/command-check.ts",
    "review:smoke": "bun scripts/review-smoke.ts",
    "build": "bun scripts/cli-bundle.ts --outdir dist --sourcemap",
    "build:bin": "bun scripts/cli-bundle.ts --entry src/bin.ts --outdir dist/bin --targets native",
    "typecheck": "ttsc -p tsconfig.json --noEmit",
    "test": "bun scripts/cli-bundle.ts --outdir .test-bundle && IDLEKIT_CLI_ENTRY=.test-bundle/main.js bun test --timeout 90000 src",
    "prepack": "bun run build && cd ../.. && bun tools/package-manifest.ts prepare packages/cli",
    "postpack": "cd ../.. && bun tools/package-manifest.ts restore packages/cli"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@gunshi/plugin-completion": "0.37.3",
    "@gunshi/plugin-suggestion": "0.37.3",
    "@idlekit/core": "workspace:*",
    "ajv": "^8.20.0",
    "gunshi": "0.37.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {}
}
