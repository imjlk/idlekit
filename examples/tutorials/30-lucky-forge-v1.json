{
  "schemaVersion": 1,
  "meta": {
    "id": "lucky-forge-v1",
    "title": "Lucky Forge V1",
    "description": "Exponential forge with seeded crits, timed frenzy events, and random chest drops. The same seed replays the same luck; Monte Carlo draws vary it.",
    "tags": [
      "builtin-model",
      "exponential",
      "stochastic",
      "worked-example"
    ]
  },
  "unit": {
    "code": "ORE",
    "symbol": "O"
  },
  "policy": {
    "mode": "accumulate",
    "maxLogGap": 14
  },
  "model": {
    "id": "exponential",
    "version": 1,
    "params": {
      "idleIncome": "1",
      "baseIncome": "1.5",
      "growthRate": 1.04,
      "costBase": "15",
      "costGrowth": 1.12,
      "maxLevel": 150,
      "softCap": {
        "kind": "pow",
        "startsAt": "2000",
        "strength": 0.6
      },
      "stochastic": {
        "crit": {
          "chance": 0.05,
          "multiplier": 10
        },
        "drops": [
          {
            "id": "chest",
            "ratePerSec": 0.01,
            "rewardIncomeSec": 120
          }
        ],
        "events": [
          {
            "id": "frenzy",
            "windowSec": 600,
            "chance": 0.5,
            "durationSec": 60,
            "incomeMultiplier": 7
          }
        ]
      }
    }
  },
  "initial": {
    "t": 0,
    "wallet": {
      "unit": "ORE",
      "amount": "0",
      "bucket": "0"
    },
    "vars": {
      "level": 0
    },
    "prestige": {
      "count": 0,
      "points": "0",
      "multiplier": "1"
    }
  },
  "clock": {
    "stepSec": 1,
    "durationSec": 3600
  },
  "strategy": {
    "id": "greedy"
  },
  "analysis": {
    "eta": {
      "mode": "simulate"
    },
    "growth": {
      "windowSec": 60
    },
    "experience": {
      "draws": 16,
      "quantiles": [
        0.1,
        0.5,
        0.9
      ]
    }
  },
  "outputs": {
    "format": "json",
    "report": {
      "checkpointsSec": [
        60,
        300,
        900,
        1800,
        3600
      ],
      "includeTrace": true,
      "traceEverySteps": 10,
      "includeGrowth": true,
      "includeUX": true
    }
  },
  "design": {
    "intent": "frequent-progression",
    "sessionPattern": {
      "id": "short-bursts",
      "days": 1
    }
  }
}
