{
  "schemaVersion": 1,
  "meta": {
    "id": "twin-currency-v1",
    "title": "Twin Currency V1",
    "description": "Built-in multi-currency model: coins plus capped gems, a generator bought with gems, a gem market with a fee, and overflow auto-conversion.",
    "tags": [
      "builtin-model",
      "multi-currency",
      "worked-example"
    ]
  },
  "unit": {
    "code": "COIN",
    "symbol": "C"
  },
  "policy": {
    "mode": "accumulate",
    "maxLogGap": 14
  },
  "model": {
    "id": "multi-currency",
    "version": 1,
    "params": {
      "primary": {
        "idleIncome": "1"
      },
      "currencies": [
        {
          "id": "gem",
          "initial": "0",
          "cap": "40",
          "valueInPrimary": 12,
          "idleIncome": "0.01"
        }
      ],
      "generators": [
        {
          "id": "mine",
          "produces": "primary",
          "incomePerLevel": "1.2",
          "costCurrency": "primary",
          "costBase": "12",
          "costGrowth": 1.12
        },
        {
          "id": "drill",
          "produces": "gem",
          "incomePerLevel": "0.02",
          "costCurrency": "primary",
          "costBase": "150",
          "costGrowth": 1.3,
          "maxLevel": 25
        },
        {
          "id": "foundry",
          "produces": "primary",
          "incomePerLevel": "12",
          "costCurrency": "gem",
          "costBase": "5",
          "costGrowth": 1.25
        }
      ],
      "exchanges": [
        {
          "id": "sell-gems",
          "from": "gem",
          "to": "primary",
          "rate": 10,
          "fee": 0.1,
          "lot": "1"
        }
      ],
      "autoConvert": [
        {
          "exchange": "sell-gems",
          "mode": "overflow"
        }
      ]
    }
  },
  "initial": {
    "t": 0,
    "wallet": {
      "unit": "COIN",
      "amount": "0",
      "bucket": "0"
    },
    "vars": {
      "levels": {
        "mine": 0,
        "drill": 0,
        "foundry": 0
      },
      "balances": {
        "gem": "0"
      }
    },
    "prestige": {
      "count": 0,
      "points": "0",
      "multiplier": "1"
    }
  },
  "clock": {
    "stepSec": 1,
    "durationSec": 3600
  },
  "strategy": {
    "id": "greedy"
  },
  "analysis": {
    "eta": {
      "mode": "simulate"
    },
    "growth": {
      "windowSec": 60
    }
  },
  "outputs": {
    "format": "json",
    "report": {
      "checkpointsSec": [
        60,
        300,
        900,
        1800,
        3600
      ],
      "includeTrace": true,
      "traceEverySteps": 10,
      "includeGrowth": true,
      "includeUX": true
    }
  }
}
