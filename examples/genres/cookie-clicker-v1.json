{
  "schemaVersion": 1,
  "meta": {
    "id": "cookie-clicker-v1",
    "title": "Cookie Clicker Genre V1",
    "description": "Genre preset: one fast-scaling generator line with seeded golden-cookie drops, frenzy events, and lucky clicks. Frequent small rewards and a soft cap late.",
    "tags": [
      "genre",
      "cookie-clicker",
      "exponential",
      "stochastic"
    ]
  },
  "unit": {
    "code": "COOKIE",
    "symbol": "C"
  },
  "policy": {
    "mode": "accumulate",
    "maxLogGap": 14
  },
  "model": {
    "id": "exponential",
    "version": 1,
    "params": {
      "idleIncome": "1",
      "baseIncome": "1",
      "growthRate": 1.06,
      "costBase": "10",
      "costGrowth": 1.15,
      "maxLevel": 200,
      "softCap": {
        "kind": "pow",
        "startsAt": "1e5",
        "strength": 0.6
      },
      "stochastic": {
        "crit": {
          "chance": 0.02,
          "multiplier": 7
        },
        "drops": [
          {
            "id": "golden-cookie",
            "ratePerSec": 0.005,
            "rewardIncomeSec": 300
          }
        ],
        "events": [
          {
            "id": "frenzy",
            "windowSec": 900,
            "chance": 0.35,
            "durationSec": 77,
            "incomeMultiplier": 7
          }
        ]
      }
    }
  },
  "initial": {
    "t": 0,
    "wallet": {
      "unit": "COOKIE",
      "amount": "0",
      "bucket": "0"
    },
    "vars": {
      "level": 0
    },
    "prestige": {
      "count": 0,
      "points": "0",
      "multiplier": "1"
    }
  },
  "clock": {
    "stepSec": 1,
    "durationSec": 3600
  },
  "strategy": {
    "id": "greedy"
  },
  "analysis": {
    "eta": {
      "mode": "simulate"
    },
    "growth": {
      "windowSec": 60
    },
    "experience": {
      "draws": 4,
      "quantiles": [
        0.1,
        0.5,
        0.9
      ]
    }
  },
  "outputs": {
    "format": "json",
    "report": {
      "checkpointsSec": [
        60,
        300,
        900,
        1800,
        3600
      ],
      "includeTrace": true,
      "traceEverySteps": 10,
      "includeGrowth": true,
      "includeUX": true
    }
  },
  "design": {
    "intent": "frequent-progression",
    "sessionPattern": {
      "id": "short-bursts",
      "days": 1
    }
  }
}
