          "unlock": [
            {
              "recipe": "lumberjack",
              "level": 2
            }
          ]
        },
        {
          "id": "sawmill",
          "inputs": {
            "wood": "3"
          },
          "outputs": {
            "plank": "1"
          },
          "timeSec": 2,
          "build": {
            "currency": "primary",
            "base": "60",
            "growth": 1.15
          },
          "unlock": [
            {
              "recipe": "lumberjack",
              "level": 3
            }
          ]
        },
        {
          "id": "workshop",
          "inputs": {
            "plank": "2",
            "stone": "2"
          },
          "outputs": {
            "tool": "1"
          },
          "timeSec": 4,
          "build": {
            "currency": "primary",
            "base": "200",
            "growth": 1.18
          },
          "unlock": [
            {
              "recipe": "sawmill",
              "level": 2
            },
            {
              "recipe": "quarry",
              "level": 2
            }
          ]
        },
        {
          "id": "trader",
          "inputs": {
            "tool": "1"
          },
          "outputs": {
            "primary": "35"
          },
          "timeSec": 2,
          "build": {
            "currency": "primary",
            "base": "500",
            "growth": 1.2
          },
          "maxLevel": 20,
          "unlock": [
            {
              "recipe": "workshop",
              "level": 1
            }
          ]
        }
      ]
    }
  },
  "initial": {
    "t": 0,
    "wallet": {
      "unit": "GOLD",
      "amount": "0",
      "bucket": "0"
    },
    "vars": {
