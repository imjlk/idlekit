{
  "schemaVersion": 1,
  "meta": {
    "id": "crafting-v1",
    "title": "Crafting Genre V1",
    "description": "Genre preset: gather wood and stone, craft planks and tools, and sell tools. Multi-resource recipes with batch times, unlock gates, and a storage cap make the bottleneck move.",
    "tags": [
      "genre",
      "crafting",
      "multi-resource",
      "production-chain"
    ]
  },
  "unit": {
    "code": "GOLD",
    "symbol": "G"
  },
  "policy": {
    "mode": "accumulate",
    "maxLogGap": 14
  },
  "model": {
    "id": "production-chain",
    "version": 1,
    "params": {
      "primary": {
        "idleIncome": "2"
      },
      "resources": [
        {
          "id": "wood",
          "valueInPrimary": 0.4
        },
        {
          "id": "stone",
          "valueInPrimary": 0.6
        },
        {
          "id": "plank",
          "valueInPrimary": 2,
          "cap": "150"
        },
        {
          "id": "tool",
          "valueInPrimary": 15
        }
      ],
      "recipes": [
        {
          "id": "lumberjack",
          "outputs": {
            "wood": "1"
          },
          "timeSec": 1,
          "build": {
            "currency": "primary",
            "base": "10",
            "growth": 1.12
          }
        },
        {
          "id": "quarry",
          "outputs": {
            "stone": "1"
